# 3D-Annotator deployment config — copy to .env and fill in.
# .env is gitignored (it holds the Django secret key + admin password). NEVER commit it.

# --- Image names (usually leave as-is) ---
ANNOTATOR_IMAGE_NAME_FULL_API=3d-annotator-api
ANNOTATOR_IMAGE_NAME_FULL_STATIC=3d-annotator-static

# --- Backend (Django) ---
# UID/GID must match the host user that owns api/static|media|db (chown before first up).
ANNOTATOR_BACKEND_UID=1000
ANNOTATOR_BACKEND_GID=1000
ANNOTATOR_BACKEND_DEBUG=false
# REQUIRED, SECRET — a long random string (e.g. `openssl rand -hex 50`).
ANNOTATOR_BACKEND_SECRET_KEY=change-me-to-a-long-random-string
# Hostnames Django will serve; include the deployment domain + `api` (internal name).
ANNOTATOR_BACKEND_ALLOWED_HOSTS=localhost,your-host.local,api
ANNOTATOR_BACKEND_CSRF_TRUSTED_ORIGINS=https://localhost,https://your-host.local
ANNOTATOR_BACKEND_TOKEN_PER_USER=5
# First-run superuser. Change the password; it's a secret.
ANNOTATOR_BACKEND_SU_NAME=admin
ANNOTATOR_BACKEND_SU_EMAIL=admin@example.com
ANNOTATOR_BACKEND_SU_PASSWORD=change-me
ANNOTATOR_BACKEND_TIMEOUT=120
ANNOTATOR_BACKEND_NUM_WORKERS=4
ANNOTATOR_BACKEND_MAX_FILE_SIZE=5368709120   # 5 GiB

# --- Deployment domain (the hostname/domain traefik serves this stack on) ---
ANNOTATOR_DEPLOYMENT_DOMAIN=your-host.local

# --- Frontend ---
ANNOTATOR_TITLE=3D-Annotator
ALLOW_SIGNUP=true

# --- Optional integrations (build-time flags; default false) ---
DBLINK_ENABLED=false
ODMLINK_ENABLED=false
# Shows the "Add model via Mosaic3D" button on the project page → deep-links to the
# Mosaic3DHub new-job form at /mosaic3dhub/projects/<id>/new-job?token=. Needs the
# Mosaic3DHub stack running behind the same traefik.
MOSAIC3D_ENABLED=false
